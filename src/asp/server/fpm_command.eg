module asp.server;

use asp;

use std;
use strings;
use strconv;

// Command-line adapter for the FastCGI service. It validates user-facing
// options, applies security capability switches before server construction,
// initializes logging, and maps master completion to a process status.
class OpenAspFpm {
    func init(self: OpenAspFpm) -> Void {
    }

    func print_help(self: OpenAspFpm) -> Void {
        print("openasp-fpm: FastCGI server for OpenASP");
        print("Usage: openasp-fpm [--root <dir>] [--host <127.0.0.1>] [--port <9000>] [--max-accepts <n>] [--workers <n>] [--worker-connections <n>] [--aot=on|off (default: on)] [--optimize=on|off (default: on)] [--log-file <path|off>] [--log-level <level|off>] [--shell-enable=on] [--process-enable=on]");
    }

    // Invalid option values return 2; runtime startup/worker failures propagate
    // the master's non-zero status. Logger ownership ends in this method.
    async func run(self: OpenAspFpm, argc: Int, argv: Int) -> Int {
        let args: asp.CommandArgs = new asp.CommandArgs();
        if args.has(argc, argv, "-h") || args.has(argc, argv, "--help") {
            self.print_help();
            return 0;
        }
        if !asp.openasp_optimize_option_valid(args, argc, argv) {
            print("invalid --optimize value; expected on or off");
            return 2;
        }
        (new asp.RuntimeOptions()).apply(argc, argv);
        let log_level: String = args.value(argc, argv, "--log-level", "info");
        if !asp.openasp_log_level_valid(log_level) {
            print("invalid --log-level value; expected info, notice, warn, error, or off");
            return 2;
        }
        let logger: asp.OpenAspLogger = new asp.OpenAspLogger(
            "openasp-fpm",
            args.value(argc, argv, "--log-file", asp.openasp_default_log_path("openasp-fpm")),
            log_level
        );
        let aot_value: String = args.value(argc, argv, "--aot", "on");
        if !strings.equal_fold_ascii(aot_value, "on") && !strings.equal_fold_ascii(aot_value, "off") {
            print("invalid --aot value; expected on or off");
            logger.error("invalid aot option");
            logger.close();
            return 2;
        }
        let root_dir: String = args.value(argc, argv, "--root", ".");
        let host: String = args.value(argc, argv, "--host", "127.0.0.1");
        let port: Int = strconv.atoi(args.value(argc, argv, "--port", "9000"));
        let max_accepts: Int = strconv.atoi(args.value(argc, argv, "--max-accepts", "0"));
        let workers: Int = strconv.atoi(args.value(argc, argv, "--workers", "2"));
        let worker_connections: Int = strconv.atoi(args.value(argc, argv, "--worker-connections", "128"));
        logger.info(
            "starting root=" + root_dir
            + " listen=" + host + ":" + strconv.itoa(port)
            + " workers=" + strconv.itoa(workers < 1 ? 1 : workers)
            + " worker_connections=" + strconv.itoa(worker_connections < 1 ? 1 : worker_connections)
            + " max_accepts=" + strconv.itoa(max_accepts)
            + " aot=" + strings.to_lower_ascii(aot_value)
            + " optimize=" + strings.to_lower_ascii(args.value(argc, argv, "--optimize", "on"))
        );
        let rc: Int = await (new FastcgiServer(root_dir, logger)).run_tcp(
            host,
            port,
            max_accepts,
            workers,
            worker_connections,
            strings.equal_fold_ascii(aot_value, "on")
        );
        logger.info("stopped status=" + strconv.itoa(rc));
        logger.close();
        return rc;
    }
}
