    // Routine lookup uses open addressing over the frozen hash table. Hash
    // matches are always confirmed by folded names to make collisions benign.
    func runtime_find_routine(self: VbsProgram, name: String, owner: String = "") -> Int {
        let cap: Int = (self.mapped_routine_hash_length > 0 ? self.mapped_routine_hash_length : std.len(self.runtime_routine_hash_blob)) / 16;
        if cap <= 0 { return self.routine_index.get_or(self.routine_lookup_key(name, owner), -1); }
        let hash: Int = self.runtime_routine_hash(name, owner);
        let probe: Int = 0;
        loop probe < cap {
            let slot: Int = ((hash % cap) + probe) % cap;
            let id: Int = self.runtime_mapped_blob_int(self.runtime_routine_hash_blob, self.mapped_routine_hash_offset, self.mapped_routine_hash_length, slot * 2 + 1, -1);
            if id < 0 { return -1; }
            if self.runtime_mapped_blob_int(self.runtime_routine_hash_blob, self.mapped_routine_hash_offset, self.mapped_routine_hash_length, slot * 2, -1) == hash && strings.equal_fold_ascii(name, self.runtime_routine_name(id)) && strings.equal_fold_ascii(owner, self.runtime_routine_owner(id)) { return id; }
            probe += 1;
        }
        return -1;
    }
    func runtime_find_routine_kind(self: VbsProgram, name: String, owner: String, want_function: Bool) -> Int {
        let cap: Int = (self.mapped_routine_hash_length > 0 ? self.mapped_routine_hash_length : std.len(self.runtime_routine_hash_blob)) / 16;
        if cap <= 0 { return self.routine_index.get_or(self.routine_kind_lookup_key(name, owner, want_function), -1); }
        let hash: Int = self.runtime_routine_hash(name, owner);
        let probe: Int = 0;
        loop probe < cap {
            let slot: Int = ((hash % cap) + probe) % cap;
            let id: Int = self.runtime_mapped_blob_int(self.runtime_routine_hash_blob, self.mapped_routine_hash_offset, self.mapped_routine_hash_length, slot * 2 + 1, -1);
            if id < 0 { return -1; }
            if self.runtime_mapped_blob_int(self.runtime_routine_hash_blob, self.mapped_routine_hash_offset, self.mapped_routine_hash_length, slot * 2, -1) == hash
            && strings.equal_fold_ascii(name, self.runtime_routine_name(id))
            && strings.equal_fold_ascii(owner, self.runtime_routine_owner(id))
            && self.runtime_routine_is_function(id) == want_function {
                return id;
            }
            probe += 1;
        }
        return -1;
    }
    func runtime_class_count(self: VbsProgram) -> Int { return self.mapped_class_length > 0 ? self.mapped_class_length / 24 : (std.len(self.runtime_class_blob) > 0 ? std.len(self.runtime_class_blob) / 24 : self.classes.len()); }
    func runtime_class_name(self: VbsProgram, id: Int) -> String { return self.mapped_class_length > 0 || std.len(self.runtime_class_blob) > 0 ? self.runtime_strings.get_unchecked(self.runtime_mapped_blob_int(self.runtime_class_blob, self.mapped_class_offset, self.mapped_class_length, id * 3, 0)) : self.classes.get(id).name; }
    func runtime_class_field_count(self: VbsProgram, id: Int) -> Int { return self.mapped_class_length > 0 || std.len(self.runtime_class_blob) > 0 ? self.runtime_mapped_blob_int(self.runtime_class_blob, self.mapped_class_offset, self.mapped_class_length, id * 3 + 2, 0) : self.classes.get(id).field_names.len(); }
    func runtime_class_field_name(self: VbsProgram, id: Int, index: Int) -> String { if self.mapped_class_length == 0 && std.len(self.runtime_class_blob) == 0 { return self.classes.get(id).field_names.get(index); } let f: Int = self.runtime_mapped_blob_int(self.runtime_class_blob, self.mapped_class_offset, self.mapped_class_length, id * 3 + 1, 0) + index; return self.runtime_strings.get_unchecked(self.runtime_mapped_blob_int(self.runtime_class_field_blob, self.mapped_class_field_offset, self.mapped_class_field_length, f * 3, 0)); }
    func runtime_class_field_bound_count(self: VbsProgram, id: Int, index: Int) -> Int { if self.mapped_class_length == 0 && std.len(self.runtime_class_blob) == 0 { return unpack_int_parts(self.classes.get(id).field_bound_expr_packs.get(index)).len(); } let f: Int = self.runtime_mapped_blob_int(self.runtime_class_blob, self.mapped_class_offset, self.mapped_class_length, id * 3 + 1, 0) + index; return self.runtime_mapped_blob_int(self.runtime_class_field_blob, self.mapped_class_field_offset, self.mapped_class_field_length, f * 3 + 2, 0); }
    func runtime_class_field_bound(self: VbsProgram, id: Int, index: Int, bound: Int) -> Int { if self.mapped_class_length == 0 && std.len(self.runtime_class_blob) == 0 { return unpack_int_parts(self.classes.get(id).field_bound_expr_packs.get(index)).get(bound); } let f: Int = self.runtime_mapped_blob_int(self.runtime_class_blob, self.mapped_class_offset, self.mapped_class_length, id * 3 + 1, 0) + index; return self.runtime_mapped_blob_int(self.runtime_meta_ids_blob, self.mapped_meta_ids_offset, self.mapped_meta_ids_length, self.runtime_mapped_blob_int(self.runtime_class_field_blob, self.mapped_class_field_offset, self.mapped_class_field_length, f * 3 + 1, 0) + bound, -1); }

    // Metadata appenders keep denormalized routine tables index-aligned. These
    // tables survive after parser objects are released.
    func add_block(self: VbsProgram, block: VbsStmtBlock) -> Int {
        let id: Int = self.blocks.len();
        _ = self.blocks.push(block);
        return id;
    }

    func add_routine(self: VbsProgram, routine: VbsRoutineDef) -> Int {
        let id: Int = self.routines.len();
        let by_ref_parts: collections.Vector<String> = new collections.Vector<String>();
        let i: Int = 0;
        loop i < routine.param_by_refs.len() {
            if routine.param_by_refs.get(i) != 0 {
                routine.has_by_ref = true;
            }
            _ = by_ref_parts.push(strconv.itoa(routine.param_by_refs.get(i)));
            i += 1;
        }
        routine.fast_scalar = false;
        _ = self.routines.push(routine);
        _ = self.routine_names.push(routine.name);
        _ = self.routine_owner_classes.push(routine.owner_class);
        _ = self.routine_is_functions.push(routine.is_function ? 1 : 0);
        _ = self.routine_param_names.push(asp.runtime.pack_string_parts(routine.param_names));
        _ = self.routine_param_by_refs.push(asp.runtime.pack_string_parts(by_ref_parts));
        _ = self.routine_block_ids.push(routine.block_id);
        _ = self.routine_writes_param_masks.push(routine.writes_param_mask);
        return id;
    }

    func routine_lookup_key(self: VbsProgram, name: String, owner_class: String = "") -> String {
        return strings.to_lower_ascii(name) + "|" + strings.to_lower_ascii(owner_class);
    }

    func routine_kind_lookup_key(self: VbsProgram, name: String, owner_class: String, is_function: Bool) -> String {
        return (is_function ? "function|" : "sub|") + self.routine_lookup_key(name, owner_class);
    }

    // Conservative eligibility analysis for the native scalar routine path.
    // Any construct requiring object dispatch, dynamic binding, or unsupported
    // control flow rejects the whole block; correctness takes priority over a
    // partial fast path.
    func stmt_scalar_identifier_target(self: VbsProgram, stmt_id: Int) -> String {
        if stmt_id < 0 || stmt_id >= self.stmts.len() {
            return "";
        }
        if std.len(self.get_stmt(stmt_id).target_name) != 0 {
            return self.get_stmt(stmt_id).target_name;
        }
        let target_expr_id: Int = self.get_stmt(stmt_id).target_expr_id;
        if target_expr_id < 0 || target_expr_id >= self.exprs.len() {
            return "";
        }
        let target_kind: VbsExprKind = self.get_expr(target_expr_id).kind;
        if target_kind == VbsExprIdentifier {
            return self.get_expr(target_expr_id).text;
        }
        let left_id: Int = self.get_expr(target_expr_id).left_id;
        if target_kind == VbsExprCall
        && left_id >= 0
        && left_id < self.exprs.len()
        && std.len(self.get_expr(target_expr_id).text) == 0
        && self.get_expr(target_expr_id).arg_ids.len() == 0
        && self.get_expr(left_id).kind == VbsExprIdentifier {
            return self.get_expr(left_id).text;
        }
        return "";
    }

    func expr_is_fast_scalar(self: VbsProgram, expr_id: Int, unsafe_call_names: collections.Vector<String>) -> Bool {
        if expr_id < 0 || expr_id >= self.exprs.len() {
            return false;
        }
        let expr_kind: VbsExprKind = self.get_expr(expr_id).kind;
        if expr_kind == VbsExprString || expr_kind == VbsExprInteger || expr_kind == VbsExprFloat || expr_kind == VbsExprBool || expr_kind == VbsExprNothing || expr_kind == VbsExprIdentifier || expr_kind == VbsExprNew {
            return true;
        }
        if expr_kind == VbsExprNeg || expr_kind == VbsExprNot {
            let left_id: Int = self.get_expr(expr_id).left_id;
            return self.expr_is_fast_scalar(left_id, unsafe_call_names);
        }
        if expr_kind == VbsExprConcat || expr_kind == VbsExprEq || expr_kind == VbsExprNe || expr_kind == VbsExprIs || expr_kind == VbsExprLt || expr_kind == VbsExprLe || expr_kind == VbsExprGt || expr_kind == VbsExprGe || expr_kind == VbsExprAdd || expr_kind == VbsExprSub || expr_kind == VbsExprMul || expr_kind == VbsExprDiv || expr_kind == VbsExprIntDiv || expr_kind == VbsExprMod || expr_kind == VbsExprAnd || expr_kind == VbsExprOr || expr_kind == VbsExprXor || expr_kind == VbsExprPow {
            let left_id: Int = self.get_expr(expr_id).left_id;
            let right_id: Int = self.get_expr(expr_id).right_id;
            return self.expr_is_fast_scalar(left_id, unsafe_call_names) && self.expr_is_fast_scalar(right_id, unsafe_call_names);
        }
        if expr_kind == VbsExprCall {
            let i: Int = 0;
            let arg_count: Int = self.get_expr(expr_id).arg_ids.len();
            let left_id: Int = self.get_expr(expr_id).left_id;
            if left_id >= 0 && !self.expr_is_fast_scalar(left_id, unsafe_call_names) {
                return false;
            }
            loop i < arg_count {
                let arg_id: Int = self.get_expr(expr_id).arg_ids.get(i);
                if !self.expr_is_fast_scalar(arg_id, unsafe_call_names) {
                    return false;
                }
                i += 1;
            }
            if left_id >= 0 || std.len(self.get_expr(expr_id).text) == 0 {
                return left_id >= 0;
            }
            i = 0;
            loop i < unsafe_call_names.len() {
                if strings.equal_fold_ascii(unsafe_call_names.get(i), self.get_expr(expr_id).text) {
                    return false;
                }
                i += 1;
            }
            return true;
        }
        return false;
    }

    func block_writes_parameters(self: VbsProgram, block_id: Int, param_names: collections.Vector<String>) -> Bool {
        if block_id < 0 || block_id >= self.blocks.len() {
            return true;
        }
        let stmt_ids: collections.Vector<Int> = self.blocks.get(block_id).stmt_ids;
        let i: Int = 0;
        loop i < stmt_ids.len() {
            let stmt_id: Int = stmt_ids.get(i);
            if stmt_id >= 0 && stmt_id < self.stmts.len() {
                let stmt: VbsStmtNode = self.get_stmt(stmt_id);
                if stmt.kind == VbsStmtAssign || stmt.kind == VbsStmtSetAssign {
                    let target_name: String = self.stmt_scalar_identifier_target(stmt_id);
                    let j: Int = 0;
                    loop j < param_names.len() {
                        if strings.equal_fold_ascii(target_name, param_names.get(j)) {
                            return true;
                        }
                        j += 1;
                    }
                }
                if stmt.kind == VbsStmtIf {
                    if self.block_writes_parameters(stmt.then_block_id, param_names) || (stmt.else_block_id >= 0 && self.block_writes_parameters(stmt.else_block_id, param_names)) {
                        return true;
                    }
                } else if stmt.kind == VbsStmtWhile || stmt.kind == VbsStmtDoLoop || stmt.kind == VbsStmtFor || stmt.kind == VbsStmtForEach {
                    if self.block_writes_parameters(stmt.body_block_id, param_names) {
                        return true;
                    }
                }
            }
            i += 1;
        }
        return false;
    }

    func block_parameter_write_mask(self: VbsProgram, block_id: Int, param_names: collections.Vector<String>) -> Int {
        if block_id < 0 || block_id >= self.blocks.len() {
            return 2147483647;
        }
        let writes_mask: Int = 0;
        let i: Int = 0;
        let stmt_count: Int = self.blocks.get(block_id).stmt_ids.len();
        loop i < stmt_count {
            let stmt_id: Int = self.blocks.get(block_id).stmt_ids.get(i);
            if stmt_id >= 0 && stmt_id < self.stmts.len() {
                let stmt_kind: VbsStmtKind = self.get_stmt(stmt_id).kind;
                if stmt_kind == VbsStmtAssign || stmt_kind == VbsStmtSetAssign {
                    let target_name: String = self.stmt_scalar_identifier_target(stmt_id);
                    let j: Int = 0;
                    loop j < param_names.len() && j < 31 {
                        if strings.equal_fold_ascii(target_name, param_names.get(j)) {
                            writes_mask = writes_mask | (1 << j);
                        }
                        j += 1;
                    }
                }
                if stmt_kind == VbsStmtIf {
                    let then_block_id: Int = self.get_stmt(stmt_id).then_block_id;
                    let else_block_id: Int = self.get_stmt(stmt_id).else_block_id;
                    writes_mask = writes_mask | self.block_parameter_write_mask(then_block_id, param_names);
                    if else_block_id >= 0 {
                        writes_mask = writes_mask | self.block_parameter_write_mask(else_block_id, param_names);
                    }
                } else if stmt_kind == VbsStmtWhile || stmt_kind == VbsStmtDoLoop || stmt_kind == VbsStmtFor || stmt_kind == VbsStmtForEach {
                    let body_block_id: Int = self.get_stmt(stmt_id).body_block_id;
                    writes_mask = writes_mask | self.block_parameter_write_mask(body_block_id, param_names);
                }
            }
            i += 1;
        }
        return writes_mask;
    }

    func block_writes_byref_parameters(self: VbsProgram, block_id: Int, param_names: collections.Vector<String>, param_by_refs: collections.Vector<Int>) -> Bool {
        if block_id < 0 || block_id >= self.blocks.len() {
            return true;
        }
        let stmt_ids: collections.Vector<Int> = self.blocks.get(block_id).stmt_ids;
        let i: Int = 0;
        loop i < stmt_ids.len() {
            let stmt_id: Int = stmt_ids.get(i);
            if stmt_id >= 0 && stmt_id < self.stmts.len() {
                let stmt: VbsStmtNode = self.get_stmt(stmt_id);
                if stmt.kind == VbsStmtAssign || stmt.kind == VbsStmtSetAssign {
                    let target_name: String = self.stmt_scalar_identifier_target(stmt_id);
                    let j: Int = 0;
                    loop j < param_names.len() {
                        if j < param_by_refs.len() && param_by_refs.get(j) != 0 && strings.equal_fold_ascii(target_name, param_names.get(j)) {
                            return true;
                        }
                        j += 1;
                    }
                }
                if stmt.kind == VbsStmtIf {
                    if self.block_writes_byref_parameters(stmt.then_block_id, param_names, param_by_refs) || (stmt.else_block_id >= 0 && self.block_writes_byref_parameters(stmt.else_block_id, param_names, param_by_refs)) {
                        return true;
                    }
                } else if stmt.kind == VbsStmtWhile || stmt.kind == VbsStmtDoLoop || stmt.kind == VbsStmtFor || stmt.kind == VbsStmtForEach {
                    if self.block_writes_byref_parameters(stmt.body_block_id, param_names, param_by_refs) {
                        return true;
                    }
                }
            }
            i += 1;
        }
        return false;
    }

    func block_is_fast_scalar(self: VbsProgram, block_id: Int, unsafe_call_names: collections.Vector<String>) -> Bool {
        if block_id < 0 || block_id >= self.blocks.len() {
            return false;
        }
        let i: Int = 0;
        let stmt_count: Int = self.blocks.get(block_id).stmt_ids.len();
        loop i < stmt_count {
            let stmt_id: Int = self.blocks.get(block_id).stmt_ids.get(i);
            if stmt_id < 0 || stmt_id >= self.stmts.len() {
                return false;
            }
            let stmt_kind: VbsStmtKind = self.get_stmt(stmt_id).kind;
            if stmt_kind == VbsStmtNoop || stmt_kind == VbsStmtOptionExplicit || stmt_kind == VbsStmtExitFunction || stmt_kind == VbsStmtExitSub || stmt_kind == VbsStmtExitProperty {
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtOnErrorResumeNext || stmt_kind == VbsStmtOnErrorGoto0 {
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtDim {
                let j: Int = 0;
                let bound_count: Int = self.get_stmt(stmt_id).target_arg_ids.len();
                loop j < bound_count {
                    if !self.expr_is_fast_scalar(self.get_stmt(stmt_id).target_arg_ids.get(j), unsafe_call_names) {
                        return false;
                    }
                    j += 1;
                }
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtConst {
                let j: Int = 0;
                let expr_count: Int = self.get_stmt(stmt_id).expr_ids.len();
                loop j < expr_count {
                    if !self.expr_is_fast_scalar(self.get_stmt(stmt_id).expr_ids.get(j), unsafe_call_names) {
                        return false;
                    }
                    j += 1;
                }
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtReDim {
                return false;
            }
            if stmt_kind == VbsStmtAssign || stmt_kind == VbsStmtSetAssign {
                let value_expr_id: Int = self.get_stmt(stmt_id).value_expr_id;
                if !self.expr_is_fast_scalar(value_expr_id, unsafe_call_names) {
                    return false;
                }
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtIf {
                let cond_expr_id: Int = self.get_stmt(stmt_id).cond_expr_id;
                let then_block_id: Int = self.get_stmt(stmt_id).then_block_id;
                let else_block_id: Int = self.get_stmt(stmt_id).else_block_id;
                if !self.expr_is_fast_scalar(cond_expr_id, unsafe_call_names) || !self.block_is_fast_scalar(then_block_id, unsafe_call_names) || (else_block_id >= 0 && !self.block_is_fast_scalar(else_block_id, unsafe_call_names)) {
                    return false;
                }
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtWhile || stmt_kind == VbsStmtDoLoop {
                let cond_expr_id: Int = self.get_stmt(stmt_id).cond_expr_id;
                let extra_expr_id: Int = self.get_stmt(stmt_id).extra_expr_id;
                let body_block_id: Int = self.get_stmt(stmt_id).body_block_id;
                if (cond_expr_id >= 0 && !self.expr_is_fast_scalar(cond_expr_id, unsafe_call_names)) || (extra_expr_id >= 0 && !self.expr_is_fast_scalar(extra_expr_id, unsafe_call_names)) || !self.block_is_fast_scalar(body_block_id, unsafe_call_names) {
                    return false;
                }
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtFor {
                let value_expr_id: Int = self.get_stmt(stmt_id).value_expr_id;
                let extra_expr_id: Int = self.get_stmt(stmt_id).extra_expr_id;
                let extra_expr_id2: Int = self.get_stmt(stmt_id).extra_expr_id2;
                let body_block_id: Int = self.get_stmt(stmt_id).body_block_id;
                if !self.expr_is_fast_scalar(value_expr_id, unsafe_call_names) || !self.expr_is_fast_scalar(extra_expr_id, unsafe_call_names) || (extra_expr_id2 >= 0 && !self.expr_is_fast_scalar(extra_expr_id2, unsafe_call_names)) || !self.block_is_fast_scalar(body_block_id, unsafe_call_names) {
                    return false;
                }
                i += 1;
                skip;
            }
            if stmt_kind == VbsStmtCall {
                let j: Int = 0;
                let arg_count: Int = self.get_stmt(stmt_id).call_arg_ids.len();
                loop j < arg_count {
                    let arg_id: Int = self.get_stmt(stmt_id).call_arg_ids.get(j);
                    if !self.expr_is_fast_scalar(arg_id, unsafe_call_names) {
                        return false;
                    }
                    j += 1;
                }
                i += 1;
                skip;
            }
            return false;
        }
        return true;
    }

    func bind_static_routine_ids(self: VbsProgram) -> Void {
        self.routine_index = new collections.Map<String, Int>();
        let i: Int = 0;
        loop i < self.routine_names.len() {
            let owner_class: String = i < self.routine_owner_classes.len() ? self.routine_owner_classes.get(i) : "";
            _ = self.routine_index.set(self.routine_lookup_key(self.routine_names.get(i), owner_class), i);
            let is_function: Bool = i < self.routine_is_functions.len() && self.routine_is_functions.get(i) != 0;
            _ = self.routine_index.set(self.routine_kind_lookup_key(self.routine_names.get(i), owner_class, is_function), i);
            i += 1;
        }
    }

    // Recomputes optimization metadata only after all routines are known,
    // allowing recursive and cross-routine calls to be classified consistently.
    func refresh_routine_metadata(self: VbsProgram) -> Void {
        // Fast-scalar eligibility is compiled into bytecode.routine_slot_counts.
    }

    func add_class(self: VbsProgram, cls: VbsClassDef) -> Int {
        let id: Int = self.classes.len();
        _ = self.classes.push(cls);
        return id;
    }

    func add_case_clause(self: VbsProgram, clause: VbsCaseClause) -> Int {
        let id: Int = self.case_clauses.len();
        _ = self.case_clauses.push(clause);
        return id;
    }

    func add_error(self: VbsProgram, msg: String) -> Void {
        _ = self.errors.push(msg);
    }

    func ok(self: VbsProgram) -> Bool {
        return self.errors.len() == 0;
    }
}
