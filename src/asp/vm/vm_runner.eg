extern func eg_asp_vm_class_enabled() -> Int;
extern func eg_asp_vm_fused_numeric_compare(op: Int, left_kind: Int, left_integer: Int, left_floating: Float64, right_kind: Int, right_integer: Int, right_floating: Float64) -> Int;
extern func eg_asp_vm_fused_integer_binary(op: Int, left: Int, right: Int) -> Int;
extern func eg_asp_vm_dispatch(arena_handle: Int, handle: Int, entry_pc: Int, limit_pc: Int) -> Int;
extern func eg_asp_vm_slot_set(arena_handle: Int, slot_index: Int, kind: Int, integer: Int, floating: Float64) -> Int;
extern func eg_asp_vm_slot_set_string(arena_handle: Int, slot_index: Int, value: String) -> Int;
extern func eg_asp_vm_take_dirty_slot(arena_handle: Int) -> Int;
extern func eg_asp_vm_slot_kind(arena_handle: Int, slot_index: Int) -> Int;
extern func eg_asp_vm_slot_integer(arena_handle: Int, slot_index: Int) -> Int;
extern func eg_asp_vm_slot_floating(arena_handle: Int, slot_index: Int) -> Float64;
extern func eg_asp_vm_slot_string(arena_handle: Int, slot_index: Int) -> String;
