extern func eg_asp_vm_object_call_cache_bind(arena_handle: Int, caller_program_id: Int, callsite_pc: Int, class_hash: Int, member_id: Int, callee_program_id: Int, routine_id: Int) -> Int;

// Reusable temporary vectors for one nested evaluator operation. Scratch frames
// are depth-indexed rather than globally shared because calls may recursively
// re-enter the runner before the outer operation has consumed its temporaries.
class VbsVmScratch {
    var values: collections.Vector<asp.runtime.Variant>;
    var aux_values: collections.Vector<asp.runtime.Variant>;
    var ids: collections.Vector<Int>;
    var ints: collections.Vector<Int>;

    func init(self: VbsVmScratch) -> Void {
        self.values = new collections.Vector<asp.runtime.Variant>();
        self.aux_values = new collections.Vector<asp.runtime.Variant>();
        self.ids = new collections.Vector<Int>();
        self.ints = new collections.Vector<Int>();
    }
    func reset(self: VbsVmScratch) -> Void {
        self.values.clear(); self.aux_values.clear(); self.ids.clear(); self.ints.clear();
    }
}

// Executes VbsBytecodeProgram while preserving full VBScript semantics.
//
// There are two cooperating engines:
// - Egret handles objects, strings, errors, dynamic calls, and all GC-visible
//   Variant values.
// - The native C dispatcher batches scalar opcodes and control flow, returning
//   a reason-coded PC whenever managed semantics or a safepoint is required.
//
// The parallel `native_*` vectors form a shadow call stack. Entries at the same
// index describe one frame and must always be pushed/popped together. Operand,
// inline, scalar, scratch, and scope storage is retained between requests to
// reduce allocation, but reset methods must remove all request-owned values.
class VbsBytecodeRunner {
    var evaluator: asp.Evaluator;
    var operand_values: collections.Vector<asp.runtime.Variant>;
    var inline_values: collections.Vector<asp.runtime.Variant>;
    var inline_frame_starts: collections.Vector<Int>;
    var scalar_values: collections.Vector<asp.runtime.Variant>;
    var scalar_frame_starts: collections.Vector<Int>;
    var empty_value: asp.runtime.Variant;
    var zero_value: asp.runtime.Variant;
    var one_value: asp.runtime.Variant;
    var minus_one_value: asp.runtime.Variant;
    var true_value: asp.runtime.Variant;
    var false_value: asp.runtime.Variant;
    var scalar_return_value: asp.runtime.Variant;
    var native_return_pcs: collections.Vector<Int>;
    var native_limit_pcs: collections.Vector<Int>;
    var native_stack_bases: collections.Vector<Int>;
    var native_slot_bases: collections.Vector<Int>;
    var native_frame_functions: collections.Vector<Int>;
    var native_frame_push_results: collections.Vector<Int>;
    var native_frame_statements: collections.Vector<Int>;
    var native_frame_copyback_masks: collections.Vector<Int>;
    var native_frame_arg_starts: collections.Vector<Int>;
    var native_arg_expr_ids: collections.Vector<Int>;
    var native_caller_scopes: collections.Vector<Scope>;
    var native_caller_error_modes: collections.Vector<Int>;
    var native_caller_routine_ids: collections.Vector<Int>;
    var scratch_frames: collections.Vector<VbsVmScratch>;
    var scratch_depth: Int;
    var scope_pool: collections.Vector<Scope>;
    var scope_pool_depth: Int;

    func init(self: VbsBytecodeRunner, evaluator: asp.Evaluator) -> Void {
        self.evaluator = evaluator;
        self.operand_values = new collections.Vector<asp.runtime.Variant>();
        self.inline_values = new collections.Vector<asp.runtime.Variant>();
        self.inline_frame_starts = new collections.Vector<Int>();
        self.scalar_values = new collections.Vector<asp.runtime.Variant>();
        self.scalar_frame_starts = new collections.Vector<Int>();
        self.empty_value = asp.runtime.variant_empty();
        self.zero_value = asp.runtime.variant_int(0);
        self.one_value = asp.runtime.variant_int(1);
        self.minus_one_value = asp.runtime.variant_int(-1);
        self.true_value = asp.runtime.variant_bool(true);
        self.false_value = asp.runtime.variant_bool(false);
        self.scalar_return_value = self.empty_value;
        self.native_return_pcs = new collections.Vector<Int>();
        self.native_limit_pcs = new collections.Vector<Int>();
        self.native_stack_bases = new collections.Vector<Int>();
        self.native_slot_bases = new collections.Vector<Int>();
        self.native_frame_functions = new collections.Vector<Int>();
        self.native_frame_push_results = new collections.Vector<Int>();
        self.native_frame_statements = new collections.Vector<Int>();
        self.native_frame_copyback_masks = new collections.Vector<Int>();
        self.native_frame_arg_starts = new collections.Vector<Int>();
        self.native_arg_expr_ids = new collections.Vector<Int>();
        self.native_caller_scopes = new collections.Vector<Scope>();
        self.native_caller_error_modes = new collections.Vector<Int>();
        self.native_caller_routine_ids = new collections.Vector<Int>();
        self.scratch_frames = new collections.Vector<VbsVmScratch>();
        self.scratch_depth = 0;
        self.scope_pool = new collections.Vector<Scope>();
        self.scope_pool_depth = 0;
    }

    // Scratch and scope pools use explicit depth counters. Acquire/reset and
    // release/reset must remain balanced across every early-return path.
    func acquire_scratch(self: VbsBytecodeRunner) -> VbsVmScratch {
        if self.scratch_depth >= self.scratch_frames.len() { _ = self.scratch_frames.push(new VbsVmScratch()); }
        let scratch: VbsVmScratch = self.scratch_frames.get_unchecked(self.scratch_depth);
        self.scratch_depth += 1;
        scratch.reset();
        return scratch;
    }
    func release_scratch(self: VbsBytecodeRunner) -> Void {
        if self.scratch_depth > 0 { self.scratch_depth -= 1; self.scratch_frames.get_unchecked(self.scratch_depth).reset(); }
    }

    func acquire_scope(self: VbsBytecodeRunner) -> Scope {
        if self.scope_pool_depth >= self.scope_pool.len() {
            _ = self.scope_pool.push(new Scope());
        }
        let scope: Scope = self.scope_pool.get_unchecked(self.scope_pool_depth);
        self.scope_pool_depth += 1;
        scope.reset();
        return scope;
    }

    func release_scope(self: VbsBytecodeRunner) -> Void {
        if self.scope_pool_depth > 0 {
            self.scope_pool_depth -= 1;
            self.scope_pool.get_unchecked(self.scope_pool_depth).reset();
        }
    }

    // Operand helpers tolerate an empty stack and use a rooted Empty singleton.
    // Bulk pop reverses stack order back into source argument order.
    func pop_variant(self: VbsBytecodeRunner, values: collections.Vector<asp.runtime.Variant>) -> asp.runtime.Variant {
        return values.len() > 0
        ? eg_asp_variant_or_fallback(values.data.pop(), self.empty_value)
        : self.empty_value;
    }

    func variant_at(self: VbsBytecodeRunner, values: collections.Vector<asp.runtime.Variant>, index: Int) -> asp.runtime.Variant {
        return index >= 0 && index < values.len()
        ? eg_asp_variant_or_fallback(values.data.get_unchecked(index), self.empty_value)
        : self.empty_value;
    }

    func discard_variant(self: VbsBytecodeRunner, values: collections.Vector<asp.runtime.Variant>) -> Void {
        if values.len() > 0 {
            _ = values.data.pop();
        }
    }

    func pop_variants_into(self: VbsBytecodeRunner, source: collections.Vector<asp.runtime.Variant>, destination: collections.Vector<asp.runtime.Variant>, count: Int) -> Void {
        destination.clear();
        if count <= 0 {
            return;
        }
        destination.reserve(count);
        let fill: Int = 0;
        loop fill < count {
            _ = destination.push(self.empty_value);
            fill += 1;
        }
        let index: Int = count - 1;
        loop index >= 0 {
            _ = destination.set(index, self.pop_variant(source));
            index -= 1;
        }
    }

    // Frequently produced scalar values are reused to avoid allocating one
    // Variant per arithmetic opcode.
    func cached_int(self: VbsBytecodeRunner, value: Int) -> asp.runtime.Variant {
        if value == 0 { return self.zero_value; }
        if value == 1 { return self.one_value; }
        if value == -1 { return self.minus_one_value; }
        return asp.runtime.variant_int(value);
    }

    func cached_bool(self: VbsBytecodeRunner, value: Bool) -> asp.runtime.Variant {
        return value ? self.true_value : self.false_value;
    }

    // Creates the immutable native instruction view once. Mapped programs keep
    // the mapping alive; managed programs copy their contiguous packed words.
    func ensure_native_program(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram) -> Int {
        _ = self;
        if bytecode.native_program_handle != 0 {
            return bytecode.native_program_handle;
        }
        let handle: Int = bytecode.mapped_image_handle != 0
            ? eg_asp_vbc_create_mapped(
                bytecode.mapped_image_handle,
                bytecode.mapped_insn_offset,
                bytecode.instruction_count()
            )
            : eg_asp_vbc_create_packed(
                bytecode.insns.data_ptr(), bytecode.instruction_count()
            );
        if handle == 0 {
            return 0;
        }
        // Literal metadata must be installed before validation freezes the
        // packed program.  The old trap-time registration happened after
        // validation and was therefore rejected by eg_asp_vbc_set_literal,
        // making every scalar region containing a constant fall back to the
        // managed Variant stack.
        let expr_id: Int = 0;
        loop expr_id < bytecode.program.runtime_expr_count() {
            let expr_kind: asp.compiler.VbsExprKind = bytecode.program.runtime_expr_kind(expr_id);
            if expr_kind == asp.compiler.VbsExprInteger {
                _ = eg_asp_vbc_set_literal(
                    handle, expr_id, asp.runtime.VariantInt => Int,
                    bytecode.program.runtime_expr_int(expr_id), 0.0
                );
            } else if expr_kind == asp.compiler.VbsExprBool {
                _ = eg_asp_vbc_set_literal(
                    handle, expr_id, asp.runtime.VariantBool => Int,
                    bytecode.program.runtime_expr_bool(expr_id) ? 1 : 0, 0.0
                );
            } else if expr_kind == asp.compiler.VbsExprFloat {
                _ = eg_asp_vbc_set_literal(
                    handle, expr_id, asp.runtime.VariantFloat => Int, 0,
                    strconv.parse_float64(bytecode.program.runtime_expr_text(expr_id))
                );
            } else if expr_kind == asp.compiler.VbsExprEmpty {
                _ = eg_asp_vbc_set_literal(handle, expr_id, 10, 0, 0.0);
            }
            expr_id += 1;
        }
        if eg_asp_vbc_validate(handle) == 0 {
            eg_asp_vbc_destroy(handle);
            return 0;
        }
        _ = __gc_keepalive(bytecode.insns);
        bytecode.native_program_handle = handle;
        return handle;
    }

    // Native slots contain only scalar payloads. Sync copies managed values in,
    // and dirty-slot draining copies native writes back at trap/yield boundaries.
    func sync_native_slot(self: VbsBytecodeRunner, ctx: asp.runtime.RequestContext, index: Int, value: asp.runtime.Variant) -> Void {
        if eg_asp_vm_native_enabled() == 0 {
            return;
        }
        let kind: Int = value.kind => Int;
        let integer: Int = value.kind == asp.runtime.VariantBool
            ? (value.bool_value ? 1 : 0)
            : value.int_value;
        // Strings remain managed until native regions can prove that every
        // consumer has exact VBScript coercion semantics.  Publishing a raw
        // string here allowed a later unsupported opcode to trap after native
        // slot writes, so replay observed mixed managed/native state.
        _ = eg_asp_vm_slot_set(
            ctx.request_arena_handle, index,
            value.kind == asp.runtime.VariantString ? -1 : kind,
            integer, value.float_value
        );
        _ = __gc_keepalive(value);
        _ = __gc_keepalive(self);
    }

    func sync_native_frame(self: VbsBytecodeRunner, ctx: asp.runtime.RequestContext, start: Int, count: Int) -> Void {
        if eg_asp_vm_native_enabled() == 0 {
            return;
        }
        let i: Int = 0;
        loop i < count && start + i < self.scalar_values.len() {
            self.sync_native_slot(ctx, start + i, self.variant_at(self.scalar_values, start + i));
            i += 1;
        }
    }

    func flush_native_dirty_slots(self: VbsBytecodeRunner, ctx: asp.runtime.RequestContext) -> Void {
        if eg_asp_vm_native_enabled() == 0 {
            return;
        }
        let index: Int = eg_asp_vm_take_dirty_slot(ctx.request_arena_handle);
        loop index >= 0 {
            if index < self.scalar_values.len() {
                let kind: Int = eg_asp_vm_slot_kind(ctx.request_arena_handle, index);
                let value: asp.runtime.Variant = kind == 10
                    ? asp.runtime.variant_empty()
                    : ((kind == (asp.runtime.VariantString => Int) || kind == 11)
                        ? asp.runtime.variant_string(
                            eg_asp_vm_slot_string(ctx.request_arena_handle, index)
                        )
                    : (kind == (asp.runtime.VariantNull => Int)
                        ? asp.runtime.variant_null()
                        : (kind == (asp.runtime.VariantBool => Int)
                    ? self.cached_bool(eg_asp_vm_slot_integer(ctx.request_arena_handle, index) != 0)
                    : (kind == (asp.runtime.VariantFloat => Int)
                        ? asp.runtime.variant_float(eg_asp_vm_slot_floating(ctx.request_arena_handle, index))
                        : self.cached_int(eg_asp_vm_slot_integer(ctx.request_arena_handle, index))))));
                _ = self.scalar_values.set(index, value);
            }
            index = eg_asp_vm_take_dirty_slot(ctx.request_arena_handle);
        }
    }

    func reset_operand_values(self: VbsBytecodeRunner) -> Void {
        loop self.operand_values.len() > 0 {
            _ = self.discard_variant(self.operand_values);
        }
    }

    func reset_inline_frames(self: VbsBytecodeRunner) -> Void {
        loop self.inline_values.len() > 0 {
            _ = self.discard_variant(self.inline_values);
        }
        loop self.inline_frame_starts.len() > 0 {
            _ = self.inline_frame_starts.pop_back(0);
        }
    }

    func reset_scalar_frames(self: VbsBytecodeRunner) -> Void {
        loop self.scalar_values.len() > 0 {
            _ = self.discard_variant(self.scalar_values);
        }
        loop self.scalar_frame_starts.len() > 0 {
            _ = self.scalar_frame_starts.pop_back(0);
        }
        self.native_return_pcs.clear();
        self.native_limit_pcs.clear();
        self.native_stack_bases.clear();
        self.native_slot_bases.clear();
        self.native_frame_functions.clear();
        self.native_frame_push_results.clear();
        self.native_frame_statements.clear();
        self.native_frame_copyback_masks.clear();
        self.native_frame_arg_starts.clear();
        self.native_arg_expr_ids.clear();
        self.native_caller_scopes.clear();
        self.native_caller_error_modes.clear();
        self.native_caller_routine_ids.clear();
    }

    // Root entry points reset retained stacks before execution and translate the
    // VM's internal signal encoding to the engine-facing result.
    func eval_root_expr(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext) -> asp.runtime.Variant {
        self.evaluator.active_bytecode = bytecode;
        self.evaluator.has_active_bytecode = true;
        ctx.prepare_global_slots(bytecode.global_slot_names);
        self.reset_operand_values();
        self.reset_inline_frames();
        self.reset_scalar_frames();
        let stack: collections.Vector<asp.runtime.Variant> = self.operand_values;
        _ = self.execute_pc(bytecode, ctx, self.evaluator.root_scope(ctx), bytecode.root_pc, bytecode.instruction_count(), stack);
        let result: asp.runtime.Variant = self.pop_variant(stack);
        return result;
    }

    func execute_root(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext) -> Int {
        self.evaluator.active_bytecode = bytecode;
        self.evaluator.has_active_bytecode = true;
        ctx.prepare_global_slots(bytecode.global_slot_names);
        self.reset_operand_values();
        self.reset_inline_frames();
        self.reset_scalar_frames();
        let root_block_id: Int = bytecode.program.root_block_id;
        let result: Int = self.execute_block(bytecode, ctx, self.evaluator.root_scope(ctx), root_block_id);
        return result;
    }

    func execute_block(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext, scope: Scope, block_id: Int, forced_pc: Int = -2, initial_routine_id: Int = -1) -> Int {
        let entry_pc: Int = forced_pc != -2 ? forced_pc : (block_id >= 0 && block_id < bytecode.block_pcs.len() ? bytecode.block_pcs.get_unchecked(block_id) : -1);
        let end_pc: Int = block_id >= 0 && block_id < bytecode.block_end_pcs.len() ? bytecode.block_end_pcs.get_unchecked(block_id) : bytecode.instruction_count();
        let stack_base: Int = self.operand_values.len();
        let result: Int = entry_pc >= 0 ? self.execute_pc(bytecode, ctx, scope, entry_pc, end_pc, self.operand_values, stack_base, initial_routine_id) : self.evaluator.execute_block_in_scope(bytecode.program, ctx, scope, block_id);
        loop self.operand_values.len() > stack_base {
            _ = self.discard_variant(self.operand_values);
        }
        return result;
    }

    // Fast scalar routines keep managed Variants rooted in `scalar_values` but
    // move frame control metadata to C. Any unsupported value or error mode
    // rejects the optimization before observable execution begins.
    func execute_fast_scalar_block(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext, routine_scope: Scope, routine_id: Int, block_id: Int, slot_count: Int, values: collections.Vector<asp.runtime.Variant>) -> asp.runtime.Variant {
        if slot_count <= 0 {
            return asp.runtime.variant_empty();
        }
        let frame_start: Int = self.scalar_values.len();
        _ = self.scalar_frame_starts.push(frame_start);
        let empty_slot: asp.runtime.Variant = asp.runtime.variant_empty();
        let i: Int = 0;
        loop i < slot_count {
            if i > 0 && i - 1 < values.len() {
                _ = self.scalar_values.push(self.variant_at(values, i - 1));
            } else {
                _ = self.scalar_values.push(empty_slot);
            }
            i += 1;
        }
        self.sync_native_frame(ctx, frame_start, slot_count);
        let entry_pc: Int = block_id >= 0 && block_id < bytecode.block_pcs.len() ? bytecode.block_pcs.get_unchecked(block_id) : 0;
        let limit_pc: Int = block_id >= 0 && block_id < bytecode.block_end_pcs.len() ? bytecode.block_end_pcs.get_unchecked(block_id) : bytecode.instruction_count();
        let native_frame_entered: Bool = eg_asp_vm_routine_enter(ctx.request_arena_handle, routine_id, 0, limit_pc, self.operand_values.len(), frame_start, slot_count) != 0;
        let caller_error_mode: Bool = ctx.error_state.resume_next_enabled;
        let stack_base: Int = self.operand_values.len();
        let result: Int = self.execute_pc(bytecode, ctx, routine_scope, entry_pc, limit_pc, self.operand_values, stack_base, routine_id);
        loop self.operand_values.len() > stack_base {
            _ = self.discard_variant(self.operand_values);
        }
        ctx.error_state.resume_next_enabled = caller_error_mode;
        self.scalar_return_value = result == 1 ? asp.runtime.variant_empty() : self.variant_at(self.scalar_values, frame_start);
        i = 0;
        loop i < values.len() && i + 1 < slot_count {
            _ = values.set(i, self.variant_at(self.scalar_values, frame_start + i + 1));
            i += 1;
        }
        _ = self.scalar_frame_starts.pop_back(0);
        loop self.scalar_values.len() > frame_start {
            _ = self.discard_variant(self.scalar_values);
        }
        if native_frame_entered {
            _ = eg_asp_vm_routine_leave(ctx.request_arena_handle);
        }
        return self.scalar_return_value;
    }

    func values_are_native_scalars(self: VbsBytecodeRunner, values: collections.Vector<asp.runtime.Variant>) -> Bool {
        _ = self;
        let i: Int = 0;
        loop i < values.len() {
            let kind: asp.runtime.VariantKind = values.get(i).kind;
            if kind == asp.runtime.VariantObject || kind == asp.runtime.VariantArray {
                return false;
            }
            i += 1;
        }
        return true;
    }

    func routine_has_writable_byref(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, routine_id: Int) -> Bool {
        _ = self;
        if routine_id < 0 || routine_id >= bytecode.program.runtime_routine_count() {
            return true;
        }
        let writes_mask: Int = routine_id < bytecode.routine_writes_masks.len()
            ? bytecode.routine_writes_masks.get_unchecked(routine_id)
            : bytecode.program.runtime_routine_writes_mask(routine_id);
        if (vbs_routine_frame_flags(bytecode, routine_id) & (VbsRoutineFrameExecute => Int)) != 0 {
            // Execute can mutate any visible ByRef parameter; static AST write
            // analysis cannot see those assignments.
            writes_mask = 2147483647;
        }
        if writes_mask == 0 {
            return false;
        }
        let param_index: Int = 0;
        loop param_index < bytecode.program.runtime_routine_param_count(routine_id) && param_index < 31 {
            if (writes_mask & (1 << param_index)) != 0
            && bytecode.program.runtime_routine_param_by_ref(routine_id, param_index) != 0 {
                return true;
            }
            param_index += 1;
        }
        return false;
    }

    func routine_c_frame_safe(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, routine_id: Int) -> Bool {
        _ = self;
        if routine_id < 0 || routine_id >= bytecode.routine_slot_counts.len() {
            return false;
        }
        let flags: Int = vbs_routine_frame_flags(bytecode, routine_id);
        return (flags & (VbsRoutineFrameHasMetadata => Int)) != 0
            && (flags & (VbsRoutineFrameCSafe => Int)) != 0;
    }

    func object_call_class_hash(self: VbsBytecodeRunner, class_name: String) -> Int {
        _ = self;
        let hash: Int = 216613626;
        let i: Int = 0;
        loop i < std.len(class_name) {
            let value: Int = std.byte_at(class_name, i);
            hash = (hash * 16777619) ^ (value >= 'A' && value <= 'Z' ? value + ('a' - 'A') : value);
            i += 1;
        }
        return hash & 2147483647;
    }

    // ByRef copy-back is represented as a bit mask and original expression IDs.
    // It occurs only after the callee frame has been restored, so writes target
    // the caller's scope and preserve VBScript aliasing behavior.
    func routine_copyback_mask(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, routine_id: Int, ctx: asp.runtime.RequestContext, scope: Scope, arg_ids: collections.Vector<Int>) -> Int {
        if routine_id < 0 || routine_id >= bytecode.program.runtime_routine_count() {
            return 0;
        }
        let writes_mask: Int = routine_id < bytecode.routine_writes_masks.len()
            ? bytecode.routine_writes_masks.get_unchecked(routine_id)
            : bytecode.program.runtime_routine_writes_mask(routine_id);
        if (vbs_routine_frame_flags(bytecode, routine_id) & (VbsRoutineFrameExecute => Int)) != 0 {
            writes_mask = 2147483647;
        }
        let mask: Int = 0;
        let i: Int = 0;
        loop i < arg_ids.len() && i < 31 && i < bytecode.program.runtime_routine_param_count(routine_id) {
            if (writes_mask & (1 << i)) != 0
            && bytecode.program.runtime_routine_param_by_ref(routine_id, i) != 0
            && self.evaluator.expr_supports_copyback(bytecode.program, ctx, scope, arg_ids.get_unchecked(i)) {
                mask = mask | (1 << i);
            }
            i += 1;
        }
        return mask;
    }

    func push_copyback_frame(self: VbsBytecodeRunner, mask: Int, arg_ids: collections.Vector<Int>) -> Void {
        _ = self.native_frame_copyback_masks.push(mask);
        _ = self.native_frame_arg_starts.push(self.native_arg_expr_ids.len());
        let i: Int = 0;
        loop i < arg_ids.len() {
            _ = self.native_arg_expr_ids.push(arg_ids.get_unchecked(i));
            i += 1;
        }
    }

    // Native slots and evaluator-visible names must belong to the same call.
    // Reusing the caller's Scope lets a callee's local assignment overwrite an
    // interpreted caller's identically named local (including object handles).
    func enter_native_scope(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext, caller_scope: Scope, routine_id: Int, object_id: Int, frame_start: Int) -> Scope {
        // The caller can be interpreted and have no native error frame.
        // Snapshot its actual mode before the callee changes On Error state.
        _ = self.native_caller_error_modes.push(ctx.error_state.resume_next_enabled ? 1 : 0);
        _ = self.native_caller_scopes.push(caller_scope);
        let scope: Scope = self.acquire_scope();
        scope.set_parent(self.evaluator.root_scope(ctx));
        scope.me_object_id = object_id;
        scope.me_class_name = bytecode.program.runtime_routine_owner(routine_id);
        scope.function_name = bytecode.program.runtime_routine_is_function(routine_id)
            ? bytecode.program.runtime_routine_name(routine_id) : "";
        let names: collections.Vector<String> = vbs_routine_slot_names(bytecode, routine_id);
        let i: Int = 0;
        loop i < names.len() {
            _ = scope.vars.set(names.get_unchecked(i), self.variant_at(self.scalar_values, frame_start + i));
            i += 1;
        }
        // Keep both scopes rooted and return a borrowed vector element.
        // Returning the newly owned Scope directly would make reassignment
        // mark execute_pc_inner's scope parameter for recursive destruction,
        // including the caller's variable table after it is restored.
        _ = self.native_caller_scopes.push(scope);
        return self.native_caller_scopes.get_unchecked(self.native_caller_scopes.len() - 1);
    }

    func assign_frame_copyback(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext, scope: Scope, caller_routine_id: Int, expr_id: Int, value: asp.runtime.Variant) -> Void {
        if caller_routine_id >= 0
        && caller_routine_id < bytecode.routine_slot_names.len()
        && self.scalar_frame_starts.len() > 0
        && expr_id >= 0
        && expr_id < bytecode.program.runtime_expr_count()
        && bytecode.program.runtime_expr_kind(expr_id) == asp.compiler.VbsExprIdentifier {
            let name: String = bytecode.program.runtime_expr_text(expr_id);
            let names: collections.Vector<String> = vbs_routine_slot_names(bytecode, caller_routine_id);
            let slot: Int = 0;
            loop slot < names.len() {
                if strings.equal_fold_ascii(names.get_unchecked(slot), name) {
                    let frame_start: Int = self.scalar_frame_starts.get_unchecked(self.scalar_frame_starts.len() - 1);
                    let value_index: Int = frame_start + slot;
                    if value_index >= 0 && value_index < self.scalar_values.len() {
                        _ = self.scalar_values.set(value_index, value);
                        self.sync_native_slot(ctx, value_index, value);
                        return;
                    }
                    break;
                }
                slot += 1;
            }
        }
        if expr_id >= 0
        && expr_id < bytecode.program.runtime_expr_count()
        && bytecode.program.runtime_expr_kind(expr_id) == asp.compiler.VbsExprIdentifier {
            let name: String = bytecode.program.runtime_expr_text(expr_id);
            if scope.me_object_id > 0 && self.evaluator.has_me_field(ctx, scope, name) {
                _ = self.evaluator.set_me_field(ctx, scope, name, value);
                return;
            }
        }
        self.evaluator.assign_target_expr(bytecode.program, ctx, scope, expr_id, value, true);
    }

    func find_dynamic_object_routine(self: VbsBytecodeRunner, class_name: String, member_name: String) -> Int {
        let definition_pos: Int = self.evaluator.dynamic_definition_indices.len() - 1;
        loop definition_pos >= 0 {
            let candidate_index: Int = self.evaluator.dynamic_definition_indices.get_unchecked(definition_pos);
            let candidate: VbsBytecodeProgram = self.evaluator.dynamic_bytecode_at(candidate_index);
            let routine_id: Int = self.evaluator.find_routine_by_function_kind(candidate.program, member_name, class_name, true);
            if routine_id >= 0 {
                return (candidate_index + 1) * 1048576 + routine_id;
            }
            definition_pos -= 1;
        }
        return -1;
    }

    // `execute_pc` owns scratch acquisition; `execute_pc_inner` is the dispatch
    // loop. `stack_floor` prevents a nested routine from consuming its caller's
    // operands. Native reason-coded returns either resume managed handling at
    // the same PC, poll GC, yield a bounded batch, or terminate.
    func execute_pc(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext, scope: Scope, entry_pc: Int, end_pc: Int = -1, stack: collections.Vector<asp.runtime.Variant> = (new collections.Vector<asp.runtime.Variant>()), stack_floor: Int = 0, initial_routine_id: Int = -1) -> Int {
        let scratch: VbsVmScratch = self.acquire_scratch();
        let native_program: Int = eg_asp_vm_native_enabled() != 0
            ? self.ensure_native_program(bytecode)
            : 0;
        let result: Int = self.execute_pc_inner(bytecode, ctx, scope, entry_pc, end_pc, stack, stack_floor, scratch, native_program, initial_routine_id);
        self.release_scratch();
        return result;
    }

    func execute_pc_inner(self: VbsBytecodeRunner, bytecode: VbsBytecodeProgram, ctx: asp.runtime.RequestContext, scope: Scope, entry_pc: Int, end_pc: Int, stack: collections.Vector<asp.runtime.Variant>, stack_floor: Int, scratch: VbsVmScratch, native_program_handle: Int, initial_routine_id: Int) -> Int {
        let pc: Int = entry_pc;
        let native_program: Int = native_program_handle;
        let native_routines_enabled: Bool = eg_asp_vm_native_enabled() != 0;
        if !native_routines_enabled {
            native_program = 0;
        }
        let native_classes_enabled: Bool = native_routines_enabled && eg_asp_vm_class_enabled() != 0;
        let instruction_count: Int = bytecode.instruction_count();
        let limit_pc: Int = end_pc >= 0 && end_pc < instruction_count ? end_pc : instruction_count;
        let native_frame_floor: Int = self.native_return_pcs.len();
        let native_current_routine_id: Int = initial_routine_id;
        loop true {
            if pc < 0 || pc >= limit_pc {
                if self.native_return_pcs.len() <= native_frame_floor {
                    break;
                }
                let frame_index: Int = self.native_return_pcs.len() - 1;
                let frame_start: Int = self.native_slot_bases.get_unchecked(frame_index);
                let frame_stack_base: Int = self.native_stack_bases.get_unchecked(frame_index);
                let frame_is_function: Bool = self.native_frame_functions.get_unchecked(frame_index) != 0;
                let frame_push_result: Bool = self.native_frame_push_results.get_unchecked(frame_index) != 0;
                let frame_statement: Bool = self.native_frame_statements.get_unchecked(frame_index) != 0;
                let copyback_mask: Int = self.native_frame_copyback_masks.pop_back(0);
                let arg_start: Int = self.native_frame_arg_starts.pop_back(self.native_arg_expr_ids.len());
                let frame_result: asp.runtime.Variant = frame_is_function
                ? self.variant_at(self.scalar_values, frame_start)
                : asp.runtime.variant_empty();
                loop stack.len() > frame_stack_base { _ = self.discard_variant(stack); }
                _ = self.scalar_frame_starts.pop_back(0);
                pc = self.native_return_pcs.pop_back(0);
                limit_pc = self.native_limit_pcs.pop_back(instruction_count);
                _ = self.native_stack_bases.pop_back(0);
                _ = self.native_slot_bases.pop_back(0);
                _ = self.native_frame_functions.pop_back(0);
                _ = self.native_frame_push_results.pop_back(0);
                _ = self.native_frame_statements.pop_back(0);
                let program_switched: Bool = eg_asp_vm_routine_program_switched(ctx.request_arena_handle) != 0;
                if program_switched {
                    let caller_dynamic_active: Bool = eg_asp_vm_routine_caller_dynamic_active(ctx.request_arena_handle) != 0;
                    let caller_dynamic_index: Int = eg_asp_vm_routine_caller_dynamic_index(ctx.request_arena_handle);
                    self.evaluator.dynamic_vm_active = caller_dynamic_active;
                    self.evaluator.dynamic_active_index = caller_dynamic_index;
                    bytecode = caller_dynamic_active
                        ? self.evaluator.dynamic_bytecode_at(caller_dynamic_index)
                        : self.evaluator.active_bytecode;
                    instruction_count = bytecode.instruction_count();
                    ctx.prepare_global_slots(bytecode.global_slot_names);
                }
                let caller_routine_id: Int = self.native_caller_routine_ids.pop_back(-1);
                _ = self.native_caller_scopes.remove_at(self.native_caller_scopes.len() - 1);
                scope = self.native_caller_scopes.get_unchecked(self.native_caller_scopes.len() - 1);
                _ = self.native_caller_scopes.remove_at(self.native_caller_scopes.len() - 1);
                self.release_scope();
                native_current_routine_id = caller_routine_id;
                let copyback_index: Int = 0;
                loop copyback_index < 31 && arg_start + copyback_index < self.native_arg_expr_ids.len() {
                    if (copyback_mask & (1 << copyback_index)) != 0 {
                        self.assign_frame_copyback(
                            bytecode, ctx, scope, native_current_routine_id,
                            self.native_arg_expr_ids.get_unchecked(arg_start + copyback_index),
                            self.variant_at(self.scalar_values, frame_start + 1 + copyback_index)
                        );
                    }
                    copyback_index += 1;
                }
                loop self.native_arg_expr_ids.len() > arg_start { _ = self.native_arg_expr_ids.pop_back(-1); }
                loop self.scalar_values.len() > frame_start { _ = self.discard_variant(self.scalar_values); }
                _ = eg_asp_vm_routine_leave(ctx.request_arena_handle);
                ctx.error_state.resume_next_enabled = self.native_caller_error_modes.pop_back(0) != 0;
                if frame_push_result {
                    _ = stack.push(frame_result);
                }
                if frame_statement {
                    let statement_result: Int = self.evaluator.finish_statement(ctx);
                    if statement_result != 0 || ctx.response.ended {
                        return statement_result == 0 && ctx.response.ended ? 1 : statement_result;
                    }
                }
                skip;
            }
            if native_routines_enabled
            && (native_program == 0 || native_program != bytecode.native_program_handle) {
                native_program = self.ensure_native_program(bytecode);
            }
            if native_program != 0 && !self.evaluator.statement_failed {
                let dispatch: Int = eg_asp_vm_dispatch(ctx.request_arena_handle, native_program, pc, limit_pc);
                if dispatch == -1 {
                    self.flush_native_dirty_slots(ctx);
                    return 0;
                }
                if dispatch == -2 {
                    // A bad native view is a soft failure: preserve the old VM.
                    self.flush_native_dirty_slots(ctx);
                    native_program = 0;
                } else {
                    let dispatch_reason: Int = dispatch % 4;
                    pc = dispatch / 4;
                    // YIELD and GC_POLL remain entirely inside the tagged
                    // native frame. Materialize dirty scalar slots only when
                    // an unsupported opcode actually crosses into managed
                    // execution.
                    if dispatch_reason == 0 {
                        self.flush_native_dirty_slots(ctx);
                    }
                    // A native branch can land exactly on the routine limit.
                    // Re-enter the frame-unwind path before reading another
                    // instruction; the next opcode belongs to the caller or
                    // another routine and may be the page's Halt instruction.
                    if pc < 0 || pc >= limit_pc {
                        skip;
                    }
                    if dispatch_reason == 1 {
                        // Re-enter managed code at a precise compiler-known
                        // safepoint; C only observes the runtime latch.
                        eg_gc_preempt_guard_enter();
                        eg_gc_preempt_guard_leave();
                        skip;
                    }
                    if dispatch_reason == 2 {
                        skip;
                    }
                }
            }
            let instruction_offset: Int = pc * 3;
            let op: Int = bytecode.instruction_word(instruction_offset);
            let arg0: Int = bytecode.instruction_word(instruction_offset + 1);
            let arg1: Int = bytecode.instruction_word(instruction_offset + 2);
            if self.evaluator.statement_failed {
                // A failed RHS must leave its destination unchanged under
                // Resume Next. Consume only this assignment's operands so an
                // enclosing expression or native caller keeps its stack.
                let discard_count: Int = 0;
                if op == (VbsBytecodeAssignScalarSlot => Int) {
                    discard_count = 1 + arg1;
                } else if op == (VbsBytecodeAssignGlobalSlot => Int)
                || op == (VbsBytecodeAssignIdentifier => Int)
                || (op >= (VbsBytecodeAssignSessionTimeout => Int) && op <= (VbsBytecodeAssignResponseStatus => Int)) {
                    discard_count = 1;
                } else if op == (VbsBytecodeAssignSessionValue => Int) || op == (VbsBytecodeAssignApplicationValue => Int) {
                    discard_count = 2;
                } else if op == (VbsBytecodeAssignStmt => Int) {
                    discard_count = 1 + bytecode.program.runtime_stmt_target_arg_count(arg0);
                } else if op == (VbsBytecodeAssignTargetDefault => Int) || op == (VbsBytecodeAssignTargetMember => Int) {
                    let target_id: Int = bytecode.program.runtime_stmt_target_expr(arg0);
                    discard_count = 1 + bytecode.program.runtime_expr_arg_count(target_id)
                        + (bytecode.program.runtime_expr_left(target_id) >= 0 ? 1 : 0);
                }
                if discard_count > 0 {
                    loop discard_count > 0 && stack.len() > stack_floor {
                        _ = self.discard_variant(stack);
                        discard_count -= 1;
                    }
                    let failed_result: Int = self.evaluator.finish_statement(ctx);
                    if failed_result != 0 {
                        return failed_result;
                    }
                    pc += 1;
                    skip;
                }
            }
            // Native scalar superinstruction:
            //   load slot/literal, load slot/literal, compare, jump-if-false.
            // It keeps primitive operands unboxed and materializes nothing.
            if native_routines_enabled && native_program == 0 && pc + 3 < limit_pc {
                let right_offset: Int = instruction_offset + 3;
                let compare_offset: Int = instruction_offset + 6;
                let branch_offset: Int = instruction_offset + 9;
                let right_op: Int = bytecode.instruction_word(right_offset);
                let compare_op: Int = bytecode.instruction_word(compare_offset);
                let branch_op: Int = bytecode.instruction_word(branch_offset);
                let source_ops: Bool = (op == (VbsBytecodePushScalarSlot => Int) || op == (VbsBytecodePushExprLeaf => Int))
                    && (right_op == (VbsBytecodePushScalarSlot => Int) || right_op == (VbsBytecodePushExprLeaf => Int));
                if source_ops
                && compare_op >= (VbsBytecodeEq => Int)
                && compare_op <= (VbsBytecodeGe => Int)
                && branch_op == (VbsBytecodeJumpIfFalse => Int) {
                    let left_kind: Int = -1;
                    let left_integer: Int = 0;
                    let left_floating: Float64 = 0.0;
                    let right_kind: Int = -1;
                    let right_integer: Int = 0;
                    let right_floating: Float64 = 0.0;
                    let frame_start: Int = self.scalar_frame_starts.len() > 0
                        ? self.scalar_frame_starts.get_unchecked(self.scalar_frame_starts.len() - 1)
                        : -1;
                    if op == (VbsBytecodePushScalarSlot => Int) {
                        let value_index: Int = frame_start + arg0;
                        if frame_start >= 0 && value_index >= 0 && value_index < self.scalar_values.len() {
                            let value: asp.runtime.Variant = self.variant_at(self.scalar_values, value_index);
                            left_kind = value.kind => Int;
                            left_integer = value.kind == asp.runtime.VariantBool ? (value.bool_value ? 1 : 0) : value.int_value;
                            left_floating = value.float_value;
                        }
                    } else if arg0 >= 0 && arg0 < bytecode.program.runtime_expr_count() {
                        let kind: asp.compiler.VbsExprKind = bytecode.program.runtime_expr_kind(arg0);
                        if kind == asp.compiler.VbsExprInteger {
                            left_kind = asp.runtime.VariantInt => Int;
                            left_integer = bytecode.program.runtime_expr_int(arg0);
                        } else if kind == asp.compiler.VbsExprFloat {
                            left_kind = asp.runtime.VariantFloat => Int;
                            left_floating = strconv.parse_float64(bytecode.program.runtime_expr_text(arg0));
                        } else if kind == asp.compiler.VbsExprBool {
                            left_kind = asp.runtime.VariantBool => Int;
                            left_integer = bytecode.program.runtime_expr_bool(arg0) ? 1 : 0;
                        }
                    }
                    let right_arg0: Int = bytecode.instruction_word(right_offset + 1);
                    if right_op == (VbsBytecodePushScalarSlot => Int) {
                        let value_index: Int = frame_start + right_arg0;
                        if frame_start >= 0 && value_index >= 0 && value_index < self.scalar_values.len() {
                            let value: asp.runtime.Variant = self.variant_at(self.scalar_values, value_index);
                            right_kind = value.kind => Int;
                            right_integer = value.kind == asp.runtime.VariantBool ? (value.bool_value ? 1 : 0) : value.int_value;
                            right_floating = value.float_value;
                        }
                    } else if right_arg0 >= 0 && right_arg0 < bytecode.program.runtime_expr_count() {
                        let kind: asp.compiler.VbsExprKind = bytecode.program.runtime_expr_kind(right_arg0);
                        if kind == asp.compiler.VbsExprInteger {
                            right_kind = asp.runtime.VariantInt => Int;
                            right_integer = bytecode.program.runtime_expr_int(right_arg0);
                        } else if kind == asp.compiler.VbsExprFloat {
                            right_kind = asp.runtime.VariantFloat => Int;
                            right_floating = strconv.parse_float64(bytecode.program.runtime_expr_text(right_arg0));
                        } else if kind == asp.compiler.VbsExprBool {
                            right_kind = asp.runtime.VariantBool => Int;
                            right_integer = bytecode.program.runtime_expr_bool(right_arg0) ? 1 : 0;
                        }
                    }
                    let fused_result: Int = eg_asp_vm_fused_numeric_compare(
                        compare_op,
                        left_kind, left_integer, left_floating,
                        right_kind, right_integer, right_floating
                    );
                    if fused_result != 2 {
                        pc = fused_result != 0
                            ? pc + 4
                            : bytecode.instruction_word(branch_offset + 2);
                        skip;
                    }
                }
                let arithmetic_op: Int = compare_op;
                let assign_op: Int = branch_op;
                let integer_arithmetic: Bool = arithmetic_op == (VbsBytecodeAdd => Int)
                    || arithmetic_op == (VbsBytecodeSub => Int)
                    || arithmetic_op == (VbsBytecodeMul => Int)
                    || arithmetic_op == (VbsBytecodeMod => Int)
                    || arithmetic_op == (VbsBytecodeAnd => Int)
                    || arithmetic_op == (VbsBytecodeOr => Int)
                    || arithmetic_op == (VbsBytecodeXor => Int);
                if source_ops && integer_arithmetic
                && assign_op == (VbsBytecodeAssignScalarSlot => Int)
                && bytecode.instruction_word(branch_offset + 2) == 0 {
                    let left_valid: Bool = false;
                    let left_value: Int = 0;
                    let right_valid: Bool = false;
                    let right_value: Int = 0;
                    let frame_start: Int = self.scalar_frame_starts.len() > 0
                        ? self.scalar_frame_starts.get_unchecked(self.scalar_frame_starts.len() - 1)
                        : -1;
                    if op == (VbsBytecodePushScalarSlot => Int) {
                        let value_index: Int = frame_start + arg0;
                        if frame_start >= 0 && value_index >= 0 && value_index < self.scalar_values.len() {
                            let value: asp.runtime.Variant = self.variant_at(self.scalar_values, value_index);
                            if value.kind == asp.runtime.VariantInt || value.kind == asp.runtime.VariantBool {
                                left_valid = true;
                                left_value = value.kind == asp.runtime.VariantBool ? (value.bool_value ? -1 : 0) : value.int_value;
                            }
                        }
                    } else if arg0 >= 0 && arg0 < bytecode.program.runtime_expr_count() {
                        let kind: asp.compiler.VbsExprKind = bytecode.program.runtime_expr_kind(arg0);
                        if kind == asp.compiler.VbsExprInteger || kind == asp.compiler.VbsExprBool {
                            left_valid = true;
                            left_value = kind == asp.compiler.VbsExprBool
                                ? (bytecode.program.runtime_expr_bool(arg0) ? -1 : 0)
                                : bytecode.program.runtime_expr_int(arg0);
                        }
                    }
                    let right_arg0: Int = bytecode.instruction_word(right_offset + 1);
                    if right_op == (VbsBytecodePushScalarSlot => Int) {
                        let value_index: Int = frame_start + right_arg0;
                        if frame_start >= 0 && value_index >= 0 && value_index < self.scalar_values.len() {
                            let value: asp.runtime.Variant = self.variant_at(self.scalar_values, value_index);
                            if value.kind == asp.runtime.VariantInt || value.kind == asp.runtime.VariantBool {
                                right_valid = true;
                                right_value = value.kind == asp.runtime.VariantBool ? (value.bool_value ? -1 : 0) : value.int_value;
                            }
                        }
                    } else if right_arg0 >= 0 && right_arg0 < bytecode.program.runtime_expr_count() {
                        let kind: asp.compiler.VbsExprKind = bytecode.program.runtime_expr_kind(right_arg0);
                        if kind == asp.compiler.VbsExprInteger || kind == asp.compiler.VbsExprBool {
                            right_valid = true;
                            right_value = kind == asp.compiler.VbsExprBool
                                ? (bytecode.program.runtime_expr_bool(right_arg0) ? -1 : 0)
                                : bytecode.program.runtime_expr_int(right_arg0);
                        }
                    }
                    if left_valid && right_valid
                    && (arithmetic_op != (VbsBytecodeMod => Int) || right_value != 0) {
                        let result_value: asp.runtime.Variant = self.cached_int(
                            eg_asp_vm_fused_integer_binary(arithmetic_op, left_value, right_value)
                        );
                        let target_slot: Int = bytecode.instruction_word(branch_offset + 1);
                        let target_index: Int = frame_start + target_slot;
