extern func eg_asp_vbc_create(instruction_count: Int) -> Int;
extern func eg_asp_vbc_create_packed(words: Ptr, instruction_count: Int) -> Int;
extern func eg_asp_vbc_create_mapped(mapping_handle: Int, byte_offset: Int, instruction_count: Int) -> Int;
extern func eg_asp_vbc_set(handle: Int, pc: Int, op: Int, arg0: Int, arg1: Int) -> Int;
extern func eg_asp_vbc_set_literal(handle: Int, expr_id: Int, kind: Int, integer: Int, floating: Float64) -> Int;
extern func eg_asp_vbc_set_string_literal(handle: Int, expr_id: Int, value: String) -> Int;
