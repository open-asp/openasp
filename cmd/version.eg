use os.process;

const OPENASP_VERSION: String = "0.1.1";
const OPENASP_COPYRIGHT: String = "https://openasp.dev";

func openasp_platform_name() -> String {
#if EG_OS_DARWIN
    return "MacOS";
#elif EG_OS_LINUX
    return "Linux";
#elif EG_OS_WINDOWS
    return "Windows";
#else
    return "Unknown OS";
#endif
}

func openasp_architecture_name() -> String {
#if EG_CPU_ARM64
    return "arm64";
#elif EG_CPU_X64
    return "x86_64";
#elif EG_CPU_X86
    return "x86";
#elif EG_CPU_ARM32
    return "arm";
#elif EG_CPU_LOONGARCH64
    return "loongarch64";
#elif EG_CPU_MIPS64
    return "mips64";
#elif EG_CPU_RISCV64
    return "riscv64";
#else
    return "unknown";
#endif
}

func print_openasp_startup_information() -> Void {
    let banner: String =
        "OpenASP " + OPENASP_VERSION + " " +
        openasp_platform_name() + " " +
        openasp_architecture_name() + " " +
        OPENASP_BUILD_TIME + " " +
        OPENASP_COPYRIGHT + "\n";
    let _, write_err = os.process.write_fd(2, banner);
    _ = write_err;
}
